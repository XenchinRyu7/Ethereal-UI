---
import DocsLayout from "../../layouts/DocsLayout.astro"
import { getRegistryByCategory } from "../../data/registry-catalog"

const primitives = getRegistryByCategory("primitives")
---

<DocsLayout
  title="Components"
  description="37+ accessible React components built with Tailwind CSS v4 and Radix UI Primitives — ready for both Light and Dark mode."
  categoryLabel="Components"
  toc={[{ id: "catalog", label: "All Components" }]}
>
  <div id="catalog" class="space-y-6">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Components
      </h1>
      <p class="text-sm text-zinc-600 dark:text-zinc-400">
        {primitives.length} base components built with semantic tokens for automatic light and dark mode switching. Select any component below to view its live preview and installation guide.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      {primitives.map((item) => (
        <a
          href={`/components/${item.slug}`}
          class="group flex flex-col justify-between rounded-2xl border border-zinc-200 bg-zinc-50/40 p-4 transition-all hover:border-zinc-300 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-zinc-700 dark:hover:bg-zinc-900"
        >
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-sm font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400 transition-colors">
                {item.title}
              </span>
              {item.isNew && (
                <span class="rounded bg-blue-100 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wide text-blue-700 dark:bg-blue-500/20 dark:text-blue-300">
                  NEW
                </span>
              )}
            </div>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2 leading-relaxed">
              {item.description}
            </p>
          </div>
          <div class="mt-3 pt-2.5 border-t border-zinc-200/70 dark:border-zinc-800/80 flex items-center justify-between font-mono text-[11px] text-zinc-400">
            <span>npx ethereal-ui add {item.slug}</span>
            <span class="text-zinc-500 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</DocsLayout>
