---
import BaseLayout from "../layouts/BaseLayout.astro"
import LandingNav from "../components/LandingNav.astro"
import { LandingHeroShowcase } from "../components/LandingHeroShowcase"
import { getRegistryByCategory } from "../data/registry-catalog"

const primitives = getRegistryByCategory("primitives")
const blocks = getRegistryByCategory("blocks")
const templates = getRegistryByCategory("templates")
---

<BaseLayout>
  <!-- Top Sticky Navigation Bar (Docs, Components, Blocks, Templates, Blog) -->
  <LandingNav />

  <!-- Centered Hero Section (shadcn/ui & BoardUI Landing style) -->
  <section class="border-b border-zinc-200/80 py-14 sm:py-20 dark:border-zinc-800/80">
    <div class="mx-auto max-w-[1400px] px-4 sm:px-6">
      <div class="mx-auto flex max-w-3xl flex-col items-center text-center space-y-5">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-zinc-50 px-3.5 py-1 text-xs font-medium text-zinc-700 shadow-2xs transition-colors hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800"
        >
          <span class="rounded-full bg-blue-100 px-2 py-0.5 text-[10px] font-semibold text-blue-700 dark:bg-blue-500/20 dark:text-blue-300">
            New
          </span>
          <span>Introducing Ethereal UI 1.0 — 37+ Components &amp; 10 Dashboard Blocks</span>
          <span class="text-zinc-400">&rarr;</span>
        </a>

        <h1 class="text-4xl font-bold tracking-tight text-zinc-900 sm:text-6xl leading-[1.08] dark:text-zinc-100">
          Build your component library &amp; SaaS dashboards faster
        </h1>

        <p class="max-w-2xl text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Beautifully designed, accessible React 19 components and dashboard blocks built with{" "}
          <strong class="font-medium text-zinc-900 dark:text-zinc-100">Tailwind CSS v4</strong> and{" "}
          <strong class="font-medium text-zinc-900 dark:text-zinc-100">Radix UI</strong>.{" "}
          Light &amp; Dark mode ready out of the box. Copy and paste via CLI or install as a package—open source and 100% free.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <a
            href="/components/avatar"
            class="inline-flex h-10 items-center justify-center rounded-xl bg-zinc-900 px-5 text-xs font-semibold text-white shadow-2xs hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-200 transition-colors"
          >
            Browse Components
          </a>
          <a
            href="/blocks"
            class="inline-flex h-10 items-center justify-center rounded-xl border border-zinc-200 bg-white px-5 text-xs font-semibold text-zinc-700 shadow-2xs hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800 transition-colors"
          >
            Explore Blocks
          </a>
          <a
            href="/docs/introduction"
            class="inline-flex h-10 items-center justify-center rounded-xl px-4 text-xs font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors"
          >
            Read Documentation &rarr;
          </a>
        </div>
      </div>

      <!-- Interactive Multi-Tab Dashboard & Component Overview Showcase -->
      <div class="mt-12">
        <LandingHeroShowcase client:load />
      </div>
    </div>
  </section>

  <!-- Overview: Base Components Directory -->
  <section class="mx-auto max-w-[1400px] px-4 sm:px-6 py-16 space-y-14">
    <div class="space-y-5">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between border-b border-zinc-200 pb-4 dark:border-zinc-800">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Base Primitives
          </span>
          <h2 class="mt-1 text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            {primitives.length} Individual Components
          </h2>
          <p class="mt-1 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
            Every component has its own dedicated documentation page with live preview, CLI installer, and variant examples.
          </p>
        </div>
        <a
          href="/components"
          class="text-xs font-medium text-blue-600 hover:underline dark:text-blue-400"
        >
          View all {primitives.length} components &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {primitives.map((item) => (
          <a
            href={`/components/${item.slug}`}
            class="group flex flex-col justify-between rounded-2xl border border-zinc-200 bg-zinc-50/40 p-4 transition-all hover:border-zinc-300 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-zinc-700 dark:hover:bg-zinc-900"
          >
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400 transition-colors">
                  {item.title}
                </span>
                {item.isNew && (
                  <span class="rounded bg-blue-100 px-1.5 py-0.5 text-[9px] font-semibold uppercase text-blue-700 dark:bg-blue-500/20 dark:text-blue-300">
                    NEW
                  </span>
                )}
              </div>
              <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2 leading-relaxed">
                {item.description}
              </p>
            </div>
            <div class="mt-3 pt-2.5 border-t border-zinc-200/70 dark:border-zinc-800/80 flex items-center justify-between font-mono text-[10px] text-zinc-400">
              <span>/components/{item.slug}</span>
              <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Overview: Dashboard Blocks Directory -->
    <div class="space-y-5">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between border-b border-zinc-200 pb-4 dark:border-zinc-800">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Application Building Blocks
          </span>
          <h2 class="mt-1 text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            {blocks.length} Production Dashboard Blocks
          </h2>
          <p class="mt-1 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
            Collapsible sidebars, KPI sparkline cards, sortable data tables with slide-over drawers, and settings forms.
          </p>
        </div>
        <a
          href="/blocks"
          class="text-xs font-medium text-blue-600 hover:underline dark:text-blue-400"
        >
          Explore all blocks &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {blocks.map((item) => (
          <a
            href={`/blocks/${item.slug}`}
            class="group flex flex-col justify-between rounded-2xl border border-zinc-200 bg-zinc-50/40 p-5 transition-all hover:border-zinc-300 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-zinc-700 dark:hover:bg-zinc-900"
          >
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-medium text-zinc-400">
                  {item.subcategory}
                </span>
                {item.isNew && (
                  <span class="rounded bg-blue-100 px-1.5 py-0.5 text-[9px] font-semibold uppercase text-blue-700 dark:bg-blue-500/20 dark:text-blue-300">
                    NEW
                  </span>
                )}
              </div>
              <h3 class="text-sm font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400 transition-colors">
                {item.title}
              </h3>
              <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
                {item.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-zinc-200/70 dark:border-zinc-800/80 flex items-center justify-between font-mono text-[11px] text-zinc-400">
              <span>npx ethereal-ui add {item.slug}</span>
              <span class="text-blue-600 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Overview: Full Page Templates -->
    <div class="space-y-5">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between border-b border-zinc-200 pb-4 dark:border-zinc-800">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Starter Layouts
          </span>
          <h2 class="mt-1 text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            Full Page Templates
          </h2>
          <p class="mt-1 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
            Complete multi-block dashboard screens ready to drop into your project.
          </p>
        </div>
        <a
          href="/templates"
          class="text-xs font-medium text-blue-600 hover:underline dark:text-blue-400"
        >
          View all templates &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        {templates.map((item) => (
          <a
            href={`/templates/${item.slug}`}
            class="group flex flex-col justify-between rounded-2xl border border-zinc-200 bg-zinc-50/40 p-5 transition-all hover:border-zinc-300 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-zinc-700 dark:hover:bg-zinc-900"
          >
            <div class="space-y-2">
              <h3 class="text-sm font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400 transition-colors">
                {item.title}
              </h3>
              <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
                {item.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-zinc-200/70 dark:border-zinc-800/80 flex items-center justify-between text-xs font-medium text-blue-600 dark:text-blue-400">
              <span>Inspect template</span>
              <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Clean Footer -->
  <footer class="border-t border-zinc-200 py-10 dark:border-zinc-800">
    <div class="mx-auto max-w-[1400px] px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500">
      <div>
        Built by <strong class="text-zinc-900 dark:text-zinc-200">Saeful Rohman (saefulrdevs)</strong>. Open-source under the MIT License.
      </div>
      <div class="flex items-center gap-5">
        <a href="/docs/introduction" class="hover:text-zinc-900 dark:hover:text-zinc-100">Docs</a>
        <a href="/components/avatar" class="hover:text-zinc-900 dark:hover:text-zinc-100">Components</a>
        <a href="/blocks" class="hover:text-zinc-900 dark:hover:text-zinc-100">Blocks</a>
        <a href="/templates" class="hover:text-zinc-900 dark:hover:text-zinc-100">Templates</a>
        <a href="/blog" class="hover:text-zinc-900 dark:hover:text-zinc-100">Blog</a>
      </div>
    </div>
  </footer>
</BaseLayout>
