---
import BaseLayout from "../layouts/BaseLayout.astro"
import LandingNav from "../components/LandingNav.astro"
import { LandingBentoShowcase } from "../components/LandingBentoShowcase"
import { LandingHeroShowcase } from "../components/LandingHeroShowcase"
import { getRegistryByCategory } from "../data/registry-catalog"

const PRIMITIVE_ITEMS = getRegistryByCategory("primitives")
const CHART_ITEMS = getRegistryByCategory("charts")
const BLOCK_ITEMS = getRegistryByCategory("blocks")
const TEMPLATE_ITEMS = getRegistryByCategory("templates")
---

<BaseLayout
  title="Ethereal UI — Modern React Components, Agentic Blocks, Statistical Charts & SaaS Templates"
  description="Open-source React UI library featuring 43 accessible Radix primitives, 20 AI/Agentic & Core Banking/HRMS enterprise blocks, 6 SVG charts, and SaaS dashboard templates for Tailwind CSS v4."
>
  <LandingNav />

  <main>
  <!-- Hero + BoardUI Interactive Visual Bento Showcase + Statistical Blocks -->
  <section class="border-b border-zinc-200/80 py-12 sm:py-16 dark:border-zinc-800/80">
    <div class="mx-auto max-w-[1400px] px-4 sm:px-6">
      <LandingBentoShowcase client:load />
    </div>
  </section>

  <!-- Full-Width Interactive Dashboard & Multi-Tab Playground -->
  <section class="border-b border-zinc-200/80 py-14 dark:border-zinc-800/80">
    <div class="mx-auto max-w-[1400px] px-4 sm:px-6 space-y-6">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Interactive Workspace Preview
          </span>
          <h2 class="mt-1 text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            Full-Page Dashboard Templates
          </h2>
          <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            Switch between Executive Analytics, Customers Data Table, Workspace Settings, and Base Primitives live.
          </p>
        </div>
        <a
          href="/templates"
          class="text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400"
        >
          Open full templates &rarr;
        </a>
      </div>

      <LandingHeroShowcase client:load />
    </div>
  </section>

  <!-- Base Components Overview Grid (37 Individual Components) -->
  <section class="border-b border-zinc-200/80 py-16 dark:border-zinc-800/80">
    <div class="mx-auto max-w-[1400px] px-4 sm:px-6 space-y-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Base Primitives
          </span>
          <h2 class="mt-1 text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            {PRIMITIVE_ITEMS.length} Accessible Components
          </h2>
          <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            Every component is documented individually with live Light &amp; Dark mode previews, variant sections, and CLI/Manual installation.
          </p>
        </div>
        <a
          href="/components/avatar"
          class="text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400"
        >
          Open Component Docs &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {
          PRIMITIVE_ITEMS.map((item) => (
            <a
              href={`/components/${item.slug}`}
              class="group flex flex-col justify-between rounded-2xl border border-zinc-200 bg-white p-4 transition-all hover:border-blue-500/50 hover:shadow-xs dark:border-zinc-800 dark:bg-zinc-900/50 dark:hover:border-blue-500/40"
            >
              <div class="space-y-1.5">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-sm font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
                    {item.title}
                  </h3>
                  {item.isNew && (
                    <span class="rounded bg-blue-100 px-1.5 py-0.5 text-[9px] font-semibold text-blue-700 dark:bg-blue-500/20 dark:text-blue-300">
                      NEW
                    </span>
                  )}
                </div>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2 leading-relaxed">
                  {item.description}
                </p>
              </div>
              <div class="mt-4 flex items-center justify-between border-t border-zinc-100 pt-2.5 text-[11px] font-mono text-zinc-400 dark:border-zinc-800/80">
                <span>/components/{item.slug}</span>
                <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Dashboard Blocks & Full Page Templates Overview -->
  <section class="py-16">
    <div class="mx-auto max-w-[1400px] px-4 sm:px-6 space-y-12">
      <!-- 6 Statistical Charts -->
      <div class="space-y-6">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
              Statistical Charts
            </span>
            <h2 class="mt-1 text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
              6 Interactive Statistical Charts
            </h2>
            <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
              Zero-dependency SVG charts for Area velocity, Dual-Series Bar, Telemetry Line, Donut breakdown, Radial SLA rings, and Activity Heatmaps.
            </p>
          </div>
          <a
            href="/charts"
            class="text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400"
          >
            View all charts &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            CHART_ITEMS.map((item) => (
              <a
                href={`/charts/${item.slug}`}
                class="group flex flex-col justify-between rounded-2xl border border-zinc-200 bg-white p-5 transition-all hover:border-blue-500/50 hover:shadow-xs dark:border-zinc-800 dark:bg-zinc-900/50 dark:hover:border-blue-500/40"
              >
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
                      {item.subcategory}
                    </span>
                    <span class="rounded bg-blue-100 px-1.5 py-0.5 text-[9px] font-semibold text-blue-700 dark:bg-blue-500/20 dark:text-blue-300">
                      NEW
                    </span>
                  </div>
                  <h3 class="text-base font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
                    {item.title}
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
                    {item.description}
                  </p>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-zinc-100 pt-3 text-[11px] font-mono text-zinc-400 dark:border-zinc-800/80">
                  <span>npx @etherealui/cli@latest add {item.slug}</span>
                  <span>&rarr;</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Enterprise & Agentic Blocks -->
      <div class="space-y-6">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
              Enterprise &amp; Agentic Blocks
            </span>
            <h2 class="mt-1 text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
              {BLOCK_ITEMS.length} Dashboard, AI &amp; FinTech/HRMS Blocks
            </h2>
            <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
              Composable production blocks for AI Prompt Composers, Agent Progress, Kanban Boards, Core Banking Ledgers, HRMS Directories, and Maker-Checker Approvals.
            </p>
          </div>
          <a
            href="/blocks"
            class="text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400"
          >
            View all blocks &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            BLOCK_ITEMS.map((item) => (
              <a
                href={`/blocks/${item.slug}`}
                class="group flex flex-col justify-between rounded-2xl border border-zinc-200 bg-white p-5 transition-all hover:border-blue-500/50 hover:shadow-xs dark:border-zinc-800 dark:bg-zinc-900/50 dark:hover:border-blue-500/40"
              >
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
                      {item.subcategory}
                    </span>
                    <span class="rounded bg-emerald-100 px-1.5 py-0.5 text-[9px] font-semibold text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-300">
                      FREE
                    </span>
                  </div>
                  <h3 class="text-base font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
                    {item.title}
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
                    {item.description}
                  </p>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-zinc-100 pt-3 text-[11px] font-mono text-zinc-400 dark:border-zinc-800/80">
                  <span>npx @etherealui/cli@latest add {item.slug}</span>
                  <span>&rarr;</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- 3 Templates -->
      <div class="space-y-6">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
              Page Templates
            </span>
            <h2 class="mt-1 text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
              3 Full-Page SaaS Reference Views
            </h2>
          </div>
          <a
            href="/templates"
            class="text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400"
          >
            View all templates &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {
            TEMPLATE_ITEMS.map((item) => (
              <a
                href={`/templates/${item.slug}`}
                class="group flex flex-col justify-between rounded-2xl border border-zinc-200 bg-white p-5 transition-all hover:border-blue-500/50 hover:shadow-xs dark:border-zinc-800 dark:bg-zinc-900/50 dark:hover:border-blue-500/40"
              >
                <div class="space-y-2">
                  <span class="text-[10px] font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
                    {item.subcategory}
                  </span>
                  <h3 class="text-base font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
                    {item.title}
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
                    {item.description}
                  </p>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-zinc-100 pt-3 text-xs font-medium text-blue-600 dark:border-zinc-800/80 dark:text-blue-400">
                  <span>Open interactive template</span>
                  <span>&rarr;</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  </main>

  <footer class="border-t border-zinc-200 py-8 dark:border-zinc-800">
    <div class="mx-auto flex max-w-[1400px] flex-col items-center justify-between gap-4 px-4 sm:flex-row sm:px-6 text-xs text-zinc-500 dark:text-zinc-400">
      <p>Built by Saeful Rohman (@saefulrdevs). Open-source MIT License.</p>
      <div class="flex flex-wrap items-center justify-center gap-5">
        <a href="/docs/introduction" class="hover:text-zinc-900 dark:hover:text-zinc-100">Docs</a>
        <a href="/components/avatar" class="hover:text-zinc-900 dark:hover:text-zinc-100">Components</a>
        <a href="/blocks" class="hover:text-zinc-900 dark:hover:text-zinc-100">Blocks</a>
        <a href="/charts" class="hover:text-zinc-900 dark:hover:text-zinc-100">Charts</a>
        <a href="/templates" class="hover:text-zinc-900 dark:hover:text-zinc-100">Templates</a>
        <a href="/blog" class="hover:text-zinc-900 dark:hover:text-zinc-100">Blog</a>
        <a href="/sitemap.xml" class="hover:text-zinc-900 dark:hover:text-zinc-100">Sitemap</a>
        <a href="/llms.txt" class="hover:text-zinc-900 dark:hover:text-zinc-100">llms.txt</a>
      </div>
    </div>
  </footer>
</BaseLayout>
