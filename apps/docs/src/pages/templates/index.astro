---
import DocsLayout from "../../layouts/DocsLayout.astro"
import { PreviewCanvas } from "../../components/PreviewCanvas"
import { getRegistryByCategory } from "../../data/registry-catalog"

const templates = getRegistryByCategory("templates")
---

<DocsLayout
  title="Templates"
  description="Full-page SaaS and enterprise dashboard templates built with Ethereal UI components and blocks."
  categoryLabel="Templates"
  toc={templates.map((t) => ({ id: t.slug, label: t.title }))}
>
  <div class="space-y-10">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Full Page Templates
      </h1>
      <p class="text-sm text-zinc-600 dark:text-zinc-400">
        Complete multi-block dashboard screens ready to copy into your application.
      </p>
    </div>

    <div class="space-y-12">
      {templates.map((item) => (
        <section id={item.slug} class="space-y-3 scroll-mt-20">
          <div class="flex items-center justify-between">
            <div>
              <a
                href={`/templates/${item.slug}`}
                class="text-base font-semibold text-zinc-900 hover:text-blue-600 dark:text-zinc-100 dark:hover:text-blue-400 transition-colors"
              >
                {item.title} &rarr;
              </a>
              <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
                {item.description}
              </p>
            </div>
          </div>

          <PreviewCanvas
            client:visible
            slug={item.slug}
            code={item.code}
            showCopyPage={true}
          />
        </section>
      ))}
    </div>
  </div>
</DocsLayout>
