---
import DocsLayout from "../layouts/DocsLayout.astro"
import { ThemeExplorerShowcase } from "../components/ThemeExplorerShowcase"
---

<DocsLayout
  title="Themes"
  description="Browse, preview, and copy 870+ community-crafted OKLCH color themes for Ethereal UI and Tailwind CSS v4 with live Light & Dark mode switching."
  categoryLabel="Themes"
  toc={[
    { id: "theme-studio", label: "Theme Explorer" },
    { id: "theming-guide", label: "Documentation & Contrast Guide" },
  ]}
>
  <div class="space-y-12">
    <!-- 1. Interactive Theme Explorer -->
    <section id="theme-studio" class="space-y-4 scroll-mt-20">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-[11px] font-semibold text-blue-700 dark:border-blue-500/30 dark:bg-blue-500/10 dark:text-blue-300">
          <span>870+ OKLCH Presets</span>
          <span>&bull;</span>
          <span>Live Preview</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Ethereal UI Themes
        </h1>
        <p class="max-w-3xl text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Click any theme preset below (or use the Theme Dropdown in the top navbar) to transform every component, agentic block, chart, and template across the documentation in real time. Copy the <code class="font-mono text-xs">:root</code> and <code class="font-mono text-xs">.dark</code> CSS variables directly into your project.
        </p>
      </div>

      <ThemeExplorerShowcase client:load />
    </section>

    <!-- 2. Link to Full Theming & Contrast Documentation -->
    <section id="theming-guide" class="space-y-4 border-t border-zinc-200 pt-8 dark:border-zinc-800 scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 rounded-2xl border border-zinc-200 bg-zinc-50/50 p-6 dark:border-zinc-800 dark:bg-zinc-900/40">
        <div class="space-y-1">
          <h2 class="text-base font-bold text-zinc-900 dark:text-zinc-100">
            Butuh Panduan Lengkap Penerapan & Pencegahan Kontras?
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
            Pelajari arsitektur CSS variables Tailwind v4, cara runtime theme switching di React, download tema via CLI/curl, dan panduan lengkap mencegah bug <strong>"Ghost Field" (Teks Putih di Field Putih)</strong>.
          </p>
        </div>
        <a
          href="/docs/theming"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-primary-foreground shadow-xs hover:bg-primary/90 transition-colors shrink-0"
        >
          <span>Buka Dokumentasi Theming & Contrast &rarr;</span>
        </a>
      </div>
    </section>
  </div>
</DocsLayout>
