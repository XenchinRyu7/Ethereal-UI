---
import BaseLayout from "../../layouts/BaseLayout.astro"
import LandingNav from "../../components/LandingNav.astro"
import { BLOG_POSTS, type BlogPost } from "../../data/blog-posts"

export async function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

interface Props {
  post: BlogPost
}

const { post } = Astro.props

// Find next and previous posts
const currentIndex = BLOG_POSTS.findIndex((p) => p.slug === post.slug)
const prevPost = currentIndex < BLOG_POSTS.length - 1 ? BLOG_POSTS[currentIndex + 1] : null
const nextPost = currentIndex > 0 ? BLOG_POSTS[currentIndex - 1] : null

// Simple helper to format basic markdown to HTML
function renderMarkdown(md: string) {
  return md
    .trim()
    .replace(/^### (.*$)/gim, '<h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 mt-6 mb-2 tracking-tight">$1</h3>')
    .replace(/^## (.*$)/gim, '<h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mt-8 mb-3 tracking-tight border-b border-zinc-200/80 pb-2 dark:border-zinc-800/80">$1</h2>')
    .replace(/```(bash|tsx|css|html|javascript|json)?([\s\S]*?)```/gim, (_, lang, code) => {
      const escaped = code.trim().replace(/</g, "&lt;").replace(/>/g, "&gt;")
      return `<div class="my-4 rounded-xl border border-zinc-200/80 bg-zinc-950 p-4 text-xs font-mono text-zinc-100 dark:border-zinc-800 overflow-x-auto shadow-2xs"><div class="flex items-center justify-between pb-2 mb-2 border-b border-zinc-800/80 text-[10px] uppercase text-zinc-400 font-semibold tracking-wider"><span>${lang || "code"}</span></div><pre><code>${escaped}</code></pre></div>`
    })
    .replace(/`([^`]+)`/g, '<code class="rounded bg-zinc-100 px-1.5 py-0.5 text-[11px] font-mono font-medium text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200 border border-zinc-200/60 dark:border-zinc-700/60">$1</code>')
    .replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-zinc-900 dark:text-zinc-100">$1</strong>')
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" class="text-blue-600 hover:underline dark:text-blue-400 font-medium">$1</a>')
    .replace(/^\- (.*$)/gim, '<li class="ml-4 list-disc text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">$1</li>')
    .replace(/\n\n/g, '<p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed my-3"></p>')
}

const htmlContent = renderMarkdown(post.content)
---

<BaseLayout
  title={`${post.title} — Ethereal UI Blog`}
  description={post.excerpt}
>
  <LandingNav />

  <main class="mx-auto max-w-3xl px-4 sm:px-6 py-12 sm:py-16 space-y-10">
    <!-- Back to Blog Button -->
    <div>
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span>Back to all posts</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="space-y-4 border-b border-zinc-200 pb-8 dark:border-zinc-800">
      <div class="flex items-center gap-2.5 text-xs text-zinc-500">
        <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-[10px] font-semibold text-blue-700 dark:bg-blue-500/20 dark:text-blue-300">
          {post.tag}
        </span>
        <span>•</span>
        <time>{post.date}</time>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100 leading-tight">
        {post.title}
      </h1>

      <p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
        {post.excerpt}
      </p>

      <!-- Author Card -->
      <div class="flex items-center gap-3 pt-2">
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-tr from-blue-600 to-indigo-500 text-xs font-bold text-white shadow-2xs">
          {post.authorAvatar}
        </div>
        <div class="text-xs">
          <p class="font-semibold text-zinc-900 dark:text-zinc-100">
            {post.author}
          </p>
          <p class="text-[11px] text-zinc-500 dark:text-zinc-400">
            {post.role}
          </p>
        </div>
      </div>
    </header>

    <!-- Article Body -->
    <article class="space-y-4 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
      <div set:html={htmlContent} />
    </article>

    <!-- Post Navigation (Prev / Next) -->
    <footer class="border-t border-zinc-200 pt-8 dark:border-zinc-800">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prevPost ? (
          <a
            href={`/blog/${prevPost.slug}`}
            class="flex flex-col gap-1 rounded-xl border border-zinc-200 p-4 transition-all hover:border-zinc-300 hover:bg-zinc-50 dark:border-zinc-800 dark:hover:border-zinc-700 dark:hover:bg-zinc-900/60"
          >
            <span class="text-[11px] font-medium text-zinc-400">← Previous Post</span>
            <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 truncate">
              {prevPost.title}
            </span>
          </a>
        ) : <div />}

        {nextPost ? (
          <a
            href={`/blog/${nextPost.slug}`}
            class="flex flex-col gap-1 rounded-xl border border-zinc-200 p-4 text-right transition-all hover:border-zinc-300 hover:bg-zinc-50 dark:border-zinc-800 dark:hover:border-zinc-700 dark:hover:bg-zinc-900/60"
          >
            <span class="text-[11px] font-medium text-zinc-400">Next Post →</span>
            <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 truncate">
              {nextPost.title}
            </span>
          </a>
        ) : <div />}
      </div>
    </footer>
  </main>
</BaseLayout>
