---
import BaseLayout from "../../layouts/BaseLayout.astro"
import LandingNav from "../../components/LandingNav.astro"
import { BLOG_POSTS } from "../../data/blog-posts"
---

<BaseLayout
  title="Blog — Ethereal UI"
  description="Engineering articles, release notes, and architecture updates from the Ethereal UI team."
>
  <LandingNav />

  <main class="mx-auto max-w-4xl px-4 sm:px-6 py-14 space-y-10">
    <div class="space-y-2 border-b border-zinc-200 pb-6 dark:border-zinc-800">
      <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
        Changelog &amp; Engineering
      </span>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Ethereal UI Blog
      </h1>
      <p class="text-sm text-zinc-600 dark:text-zinc-400">
        Release announcements, architecture deep-dives, and component engineering updates.
      </p>
    </div>

    <div class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {BLOG_POSTS.map((post) => (
        <article class="py-8 first:pt-2 space-y-3 group">
          <div class="flex items-center gap-2.5 text-xs text-zinc-500">
            <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-[10px] font-semibold text-blue-700 dark:bg-blue-500/20 dark:text-blue-300">
              {post.tag}
            </span>
            <span>•</span>
            <time>{post.date}</time>
          </div>

          <h2 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            <a
              href={`/blog/${post.slug}`}
              class="group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
            >
              {post.title}
            </a>
          </h2>

          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {post.excerpt}
          </p>

          <div class="pt-2 flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-blue-600 text-[9px] font-bold text-white">
                {post.authorAvatar}
              </div>
              <span class="text-zinc-500">
                By <strong class="font-medium text-zinc-800 dark:text-zinc-200">{post.author}</strong>
              </span>
            </div>
            <a
              href={`/blog/${post.slug}`}
              class="font-medium text-blue-600 hover:underline dark:text-blue-400 inline-flex items-center gap-1"
            >
              <span>Read article</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
