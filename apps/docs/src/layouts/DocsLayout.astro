---
import BaseLayout from "./BaseLayout.astro"
import DocsSidebar from "../components/DocsSidebar.astro"
import TopNav from "../components/TopNav.astro"

interface TocItem {
  id: string
  label: string
}

interface Props {
  title: string
  description?: string
  categoryLabel?: string
  toc?: TocItem[]
}

const {
  title,
  description,
  categoryLabel = "Components",
  toc = [
    { id: "preview", label: "Preview" },
    { id: "installation", label: "Installation" },
  ],
} = Astro.props

const seoCategorySuffix =
  categoryLabel === "Blocks"
    ? "React Dashboard & Agentic Block"
    : categoryLabel === "Charts"
      ? "React Statistical SVG Chart"
      : categoryLabel === "Templates"
        ? "Full-Page React SaaS Template"
        : categoryLabel === "Documentation"
          ? "Documentation & Setup Guide"
          : "React UI Component"

const seoKeywords = `${title}, ${title} React, ${title} Tailwind CSS, @etherealui/react ${title.toLowerCase()}, Ethereal UI ${categoryLabel.toLowerCase()}, Radix UI, Tailwind v4`
---

<BaseLayout
  title={`${title} — ${seoCategorySuffix} | Ethereal UI`}
  description={description}
  keywords={seoKeywords}
  categoryLabel={categoryLabel}
  ogType="article"
>
  <div class="mx-auto p-3 sm:p-4">
    <div class="flex flex-col lg:flex-row gap-8 xl:gap-12">
      <!-- 1. Left Floating Sidebar Card (BoardUI style) -->
      <DocsSidebar />

      <!-- 2. Center Main Documentation Content -->
      <div class="flex-1 min-w-0 mx-auto w-full pt-2 pb-20">
        <TopNav categoryLabel={categoryLabel} pageTitle={title} />

        <main class="mt-8">
          <slot />
        </main>
      </div>

      <!-- 3. Right Sticky Table of Contents ("On this page") -->
      <aside class="hidden xl:block w-52 shrink-0 pt-2">
        <div class="sticky top-8 space-y-3">
          <div class="flex items-center gap-2 text-xs font-semibold text-zinc-900 dark:text-zinc-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400">
              <line x1="21" x2="3" y1="6" y2="6"/>
              <line x1="15" x2="3" y1="12" y2="12"/>
              <line x1="17" x2="3" y1="18" y2="18"/>
            </svg>
            <span>On this page</span>
          </div>

          <ul id="docs-toc-list" class="relative border-l border-zinc-200 dark:border-zinc-800 space-y-2 text-xs">
            <span
              id="docs-toc-indicator"
              class="pointer-events-none absolute -left-px top-0 w-0.5 bg-zinc-900 dark:bg-zinc-100 transition-all duration-200 ease-out"
              style="height: 16px; transform: translateY(0px);"
            ></span>
            {toc.map((item, idx) => (
              <li data-toc-item={item.id} class="relative pl-3.5">
                <a
                  href={`#${item.id}`}
                  data-toc-link={item.id}
                  class:list={[
                    "block py-0.5 transition-colors",
                    idx === 0
                      ? "font-medium text-zinc-900 dark:text-zinc-100"
                      : "text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>

  <script>
    function initDocsTocScrollSpy() {
      const tocList = document.getElementById("docs-toc-list")
      const indicator = document.getElementById("docs-toc-indicator")
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
      )

      if (!tocList || !indicator || tocLinks.length === 0) return

      const ids = tocLinks
        .map((link) => link.getAttribute("data-toc-link") || "")
        .filter(Boolean)

      let activeId = ids[0]
      let manualLockUntil = 0

      function setActiveToc(id: string) {
        if (!id) return
        activeId = id

        tocLinks.forEach((link) => {
          const linkId = link.getAttribute("data-toc-link")
          const isActive = linkId === id

          if (isActive) {
            link.classList.add("font-medium", "text-zinc-900", "dark:text-zinc-100")
            link.classList.remove(
              "text-zinc-500",
              "hover:text-zinc-900",
              "dark:text-zinc-400",
              "dark:hover:text-zinc-200"
            )

            const li = link.closest("li") as HTMLElement | null
            if (li && indicator) {
              indicator.style.height = `${li.offsetHeight}px`
              indicator.style.transform = `translateY(${li.offsetTop}px)`
            }
          } else {
            link.classList.remove("font-medium", "text-zinc-900", "dark:text-zinc-100")
            link.classList.add(
              "text-zinc-500",
              "hover:text-zinc-900",
              "dark:text-zinc-400",
              "dark:hover:text-zinc-200"
            )
          }
        })
      }

      function computeActiveSection() {
        if (Date.now() < manualLockUntil) return

        const sections = ids
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => el !== null)

        if (sections.length === 0) return

        const scrollBottom = window.innerHeight + window.scrollY
        const docHeight = document.documentElement.scrollHeight
        if (docHeight - scrollBottom <= 24) {
          setActiveToc(sections[sections.length - 1].id)
          return
        }

        const threshold = 140
        let currentId = sections[0].id

        for (const section of sections) {
          const rect = section.getBoundingClientRect()
          if (rect.top <= threshold) {
            currentId = section.id
          } else {
            break
          }
        }

        setActiveToc(currentId)
      }

      tocLinks.forEach((link) => {
        link.addEventListener("click", () => {
          const targetId = link.getAttribute("data-toc-link")
          if (targetId) {
            manualLockUntil = Date.now() + 650
            setActiveToc(targetId)
          }
        })
      })

      window.addEventListener("scroll", computeActiveSection, { passive: true })
      window.addEventListener("resize", () => {
        setActiveToc(activeId)
        computeActiveSection()
      })
      window.addEventListener("hashchange", () => {
        const hashId = window.location.hash.replace(/^#/, "")
        if (hashId && ids.includes(hashId)) {
          manualLockUntil = Date.now() + 650
          setActiveToc(hashId)
        }
      })

      // Handle initial hash (including after React client:load hydration)
      function syncInitialHashOrScroll() {
        const hashId = window.location.hash.replace(/^#/, "")
        if (hashId && ids.includes(hashId)) {
          const targetEl = document.getElementById(hashId)
          if (targetEl) {
            targetEl.scrollIntoView({ block: "start" })
          }
          manualLockUntil = Date.now() + 650
          setActiveToc(hashId)
        } else {
          computeActiveSection()
        }
      }

      syncInitialHashOrScroll()

      // Re-run once hydrated React sections mount inside <main>
      const mainEl = document.querySelector("main")
      if (mainEl) {
        const observer = new MutationObserver(() => {
          const allMounted = ids.every((id) => document.getElementById(id) !== null)
          if (allMounted) {
            syncInitialHashOrScroll()
            observer.disconnect()
          }
        })
        observer.observe(mainEl, { childList: true, subtree: true })
      }
    }

    initDocsTocScrollSpy()
    document.addEventListener("astro:page-load", initDocsTocScrollSpy)
  </script>
</BaseLayout>
