---
import { NavbarSearchModal } from "./NavbarSearchModal"
import { ThemeToggle } from "./ThemeToggle"

const pathname = Astro.url.pathname
---

<header class="sticky top-0 z-40 w-full border-b border-zinc-200/80 bg-white/85 backdrop-blur-md dark:border-zinc-800/80 dark:bg-[#09090b]/85">
  <div class="mx-auto flex h-14 max-w-[1400px] items-center justify-between px-4 sm:px-6">
    <!-- Left Brand & Primary Navigation (Docs, Components, Blocks, Templates, Blog) -->
    <div class="flex items-center gap-7">
      <a href="/" class="flex items-center gap-2.5">
        <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-600 text-white shadow-2xs">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="3"/>
            <path d="M9 3v18"/>
            <path d="M9 9h12"/>
          </svg>
        </div>
        <span class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Ethereal UI
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-5 text-xs font-medium">
        <a
          href="/docs/introduction"
          class:list={[
            "transition-colors",
            pathname.startsWith("/docs")
              ? "text-zinc-900 dark:text-white font-semibold"
              : "text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100",
          ]}
        >
          Docs
        </a>
        <a
          href="/components/avatar"
          class:list={[
            "transition-colors",
            pathname.startsWith("/components")
              ? "text-zinc-900 dark:text-white font-semibold"
              : "text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100",
          ]}
        >
          Components
        </a>
        <a
          href="/blocks"
          class:list={[
            "transition-colors flex items-center gap-1.5",
            pathname.startsWith("/blocks")
              ? "text-zinc-900 dark:text-white font-semibold"
              : "text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100",
          ]}
        >
          Blocks
          <span class="rounded bg-blue-100 px-1.5 py-0.5 text-[9px] font-semibold text-blue-700 dark:bg-blue-500/20 dark:text-blue-300">
            FREE
          </span>
        </a>
        <a
          href="/templates"
          class:list={[
            "transition-colors",
            pathname.startsWith("/templates")
              ? "text-zinc-900 dark:text-white font-semibold"
              : "text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100",
          ]}
        >
          Templates
        </a>
        <a
          href="/blog"
          class:list={[
            "transition-colors",
            pathname.startsWith("/blog")
              ? "text-zinc-900 dark:text-white font-semibold"
              : "text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100",
          ]}
        >
          Blog
        </a>
      </nav>
    </div>

    <!-- Right Search, Theme Toggle, GitHub & CTA -->
    <div class="flex items-center gap-2">
      <div class="w-44 sm:w-56">
        <NavbarSearchModal client:load />
      </div>

      <ThemeToggle client:load />

      <a
        href="https://github.com/saefulrdevs/ethereal-ui"
        target="_blank"
        rel="noreferrer"
        class="hidden sm:inline-flex h-8 items-center gap-1.5 rounded-xl border border-zinc-200 bg-white px-2.5 text-xs font-medium text-zinc-700 shadow-2xs hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span>1,048</span>
      </a>

      <a
        href="/components/avatar"
        class="hidden md:inline-flex h-8 items-center justify-center rounded-xl bg-zinc-900 px-3 text-xs font-medium text-white hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-200 transition-colors"
      >
        Get Started
      </a>
    </div>
  </div>
</header>

