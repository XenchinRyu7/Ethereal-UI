---
import { ThemeToggle } from "./ThemeToggle"

interface Props {
  categoryLabel?: string
  pageTitle?: string
}

const { categoryLabel = "Components", pageTitle } = Astro.props
---

<header class="flex h-12 w-full items-center justify-between border-b border-zinc-200/70 pb-3 dark:border-zinc-800/80">
  <!-- Left Breadcrumb Trail (Exact BoardUI style) -->
  <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs">
    <a href="/" class="flex items-center gap-1.5 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">
      <span class="flex h-4 w-4 items-center justify-center rounded bg-blue-600 text-[9px] font-bold text-white">
        E
      </span>
      <span>Ethereal UI</span>
    </a>
    <span class="text-zinc-300 dark:text-zinc-700">&gt;</span>
    <a
      href={
        categoryLabel === "Charts"
          ? "/charts"
          : categoryLabel === "Blocks"
          ? "/blocks"
          : categoryLabel === "Templates"
          ? "/templates"
          : "/components"
      }
      class="text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      {categoryLabel}
    </a>
    {pageTitle && (
      <>
        <span class="text-zinc-300 dark:text-zinc-700">&gt;</span>
        <span class="font-medium text-zinc-900 dark:text-zinc-100">
          {pageTitle}
        </span>
      </>
    )}
  </nav>

  <!-- Right Action Links (Docs, Blog) + Icons & Pills -->
  <div class="flex items-center gap-3">
    <div class="hidden sm:flex items-center gap-4 text-xs font-medium text-zinc-500 dark:text-zinc-400 mr-1">
      <a href="/docs/introduction" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Docs
      </a>
      <a href="/components/avatar" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Components
      </a>
      <a href="/charts" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Charts
      </a>
      <a href="/blocks" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Blocks
      </a>
      <a href="/blog" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Blog
      </a>
    </div>

    <div class="flex items-center gap-1.5">
      <ThemeToggle client:load />

      <a
        href="https://x.com"
        target="_blank"
        rel="noreferrer"
        aria-label="X"
        class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>

      <a
        href="https://github.com/XenchinRyu7/Ethereal-UI"
        target="_blank"
        rel="noreferrer"
        class="inline-flex h-8 items-center gap-1.5 rounded-xl border border-zinc-200 bg-white px-2.5 text-xs font-medium text-zinc-700 shadow-2xs hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span>1,048</span>
      </a>
    </div>
  </div>
</header>
