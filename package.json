{
  "name": "ethereal-ui-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Free, Open-Source, Modern Light & Dark Mode Enterprise Dashboard Blocks & Component System",
  "author": "Saeful Rohman (saefulrdevs)",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint \"packages/ui/src/**/*.{ts,tsx}\" \"apps/docs/src/**/*.{ts,tsx}\" && turbo run lint",
    "typecheck": "turbo run lint",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @etherealui/react build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
