{
  "name": "@etherealui/cli",
  "version": "0.0.5",
  "description": "Official CLI for Ethereal UI (@etherealui/react) — scaffold enterprise React components, charts, and dashboard blocks from the JSON Registry.",
  "license": "MIT",
  "author": "Saeful Rohman <saefulrohmandevelopers@gmail.com> (https://saefulrohman.dev)",
  "homepage": "https://ethereal-ui.saefulrohman.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/XenchinRyu7/Ethereal-UI.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/XenchinRyu7/Ethereal-UI/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/XenchinRyu7"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
